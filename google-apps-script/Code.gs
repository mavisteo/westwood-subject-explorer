/** Westwood subject planner. Staff must use the school-domain deployment. */
const TABLES_={Subjects:['subject_id','subject_name','levels','category','short_description','full_description','suitable_for','learning_experience','skills','considerations','source','review_status','active','level_descriptors'],Subject_Combinations:['combination_id','profile','combination_name','description','active','optional_groups'],Combination_Subjects:['combination_id','subject_id','role','selection_group','group_label','rank_required','display_order'],Subject_Eligibility:['subject_id','subject_level','eligibility_text','active'],Admins:['email','role','active'],Change_Log:['timestamp','user','action','record_type','record_id','previous_value','new_value']};
function setup(){
 const props=PropertiesService.getScriptProperties();if(props.getProperty('SHEET_ID'))throw Error('Already installed. Open the existing workbook; setup will not overwrite it.');
 const email=Session.getActiveUser().getEmail().toLowerCase();if(!email)throw Error('Run setup in the script editor while signed into your school account.');
 const book=SpreadsheetApp.create('Westwood Subject Explorer — content');
 props.setProperties({SHEET_ID:book.getId(),OWNER_EMAIL:email,REVISION:'1'});
 Object.keys(TABLES_).forEach((t,i)=>{const sh=i===0?book.getSheets()[0].setName(t):book.insertSheet(t);sh.appendRow(TABLES_[t]);sh.setFrozenRows(1);sh.getRange(1,1,1,TABLES_[t].length).setFontWeight('bold').setBackground('#e6eddb');});
 const seed=JSON.parse(HtmlService.createHtmlOutputFromFile('Seed').getContent());
 write_(book,'Subjects',seed.subjects);write_(book,'Subject_Combinations',seed.combinations);write_(book,'Combination_Subjects',flatten_(seed.combinations));write_(book,'Subject_Eligibility',seed.eligibility);write_(book,'Admins',[{email:email,role:'Admin',active:true}]);
 props.setProperty('SOURCES',JSON.stringify(seed.sources));
 book.getSheetByName('Change_Log').appendRow([new Date().toISOString(),email,'install','system','setup','','Initial content installed']);
 console.log('Workbook: '+book.getUrl());return book.getUrl();
}
function book_(){const id=PropertiesService.getScriptProperties().getProperty('SHEET_ID');if(!id)throw Error('Run setup in the Apps Script editor first.');return SpreadsheetApp.openById(id);}
function isTrue_(x){return x===true||String(x).toLowerCase()==='true';}
function records_(book,table){const rows=book.getSheetByName(table).getDataRange().getDisplayValues(),headers=rows.shift();return rows.filter(r=>r.some(Boolean)).map(r=>Object.fromEntries(headers.map((h,i)=>[h,decode_(r[i])])));}
function decode_(v){if(v==='true'||v==='TRUE')return true;if(v==='false'||v==='FALSE')return false;if(v.startsWith('[')||v.startsWith('{')){try{return JSON.parse(v);}catch{}}return v;}
function cell_(v){if(v===undefined||v===null)return '';if(typeof v==='object')return JSON.stringify(v);if(typeof v==='boolean')return v;return typeof v==='string'&&/^[=+\-@]/.test(v)?"'"+v:v;}
function write_(book,table,records){const sh=book.getSheetByName(table),headers=TABLES_[table];sh.getRange(1,1,1,headers.length).setValues([headers]);if(sh.getLastRow()>1)sh.getRange(2,1,sh.getLastRow()-1,headers.length).clearContent();if(records.length)sh.getRange(2,1,records.length,headers.length).setValues(records.map(r=>headers.map(h=>cell_(r[h]))));}
function flatten_(combos){const out=[];combos.forEach(c=>{['compulsory','optional','closed_optional'].forEach(role=>(c[role]||[]).forEach((id,i)=>out.push({combination_id:c.combination_id,subject_id:id,role:role,selection_group:'',group_label:'',rank_required:false,display_order:i})));c.groups.forEach(g=>g.options.forEach((id,i)=>out.push({combination_id:c.combination_id,subject_id:id,role:'selectable',selection_group:g.id,group_label:g.label,rank_required:g.rank_required,display_order:i})));});return out;}
function publicData_(){const book=book_(),combos=records_(book,'Subject_Combinations'),links=records_(book,'Combination_Subjects');combos.forEach(c=>{c.active=isTrue_(c.active);c.optional_groups=Array.isArray(c.optional_groups)?c.optional_groups:[];['compulsory','optional','closed_optional'].forEach(role=>c[role]=links.filter(r=>r.combination_id===c.combination_id&&r.role===role).sort((a,b)=>Number(a.display_order)-Number(b.display_order)).map(r=>r.subject_id));const gl=links.filter(r=>r.combination_id===c.combination_id&&r.role==='selectable');c.groups=[...new Set(gl.map(r=>r.selection_group))].map(id=>{const rs=gl.filter(r=>r.selection_group===id).sort((a,b)=>Number(a.display_order)-Number(b.display_order));return {id:id,label:rs[0].group_label,options:rs.map(r=>r.subject_id),min_select:1,max_select:1,rank_required:isTrue_(rs[0].rank_required)};});});return {version:1,updated:new Date().toISOString(),subjects:records_(book,'Subjects').map(s=>({...s,active:isTrue_(s.active)})),combinations:combos,eligibility:records_(book,'Subject_Eligibility').map(e=>({...e,active:isTrue_(e.active)})),sources:JSON.parse(PropertiesService.getScriptProperties().getProperty('SOURCES')||'{}')};}
function staff_(){const email=Session.getActiveUser().getEmail().toLowerCase();if(!email)throw Error('Google could not verify your school email. Open the school-domain staff deployment while signed into your school Google account.');const record=records_(book_(),'Admins').find(a=>String(a.email).toLowerCase()===email&&isTrue_(a.active)&&['Admin','Editor'].includes(a.role));if(!record)throw Error('Your Google account is not on the staff allowlist. Ask a Westwood administrator for access.');return {email:email,role:record.role};}
function doGet(e){
 try{if(e.parameter.mode==='admin'){staff_();return HtmlService.createTemplateFromFile('Admin').evaluate().setTitle('Westwood — staff dashboard');}
 const template=HtmlService.createTemplateFromFile('Student');template.bootstrap=JSON.stringify(publicData_()).replace(/</g,'\\u003c');template.staffUrl=PropertiesService.getScriptProperties().getProperty('ADMIN_URL')||ScriptApp.getService().getUrl()+'?mode=admin';return template.evaluate().setTitle('Westwood Subject Explorer').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
 }catch(error){return HtmlService.createHtmlOutput('<h2>Unable to open this page</h2><p>'+String(error.message).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))+'</p>');}
}
function getPublicContent(){return publicData_();}
function getAdminData(){const actor=staff_(),book=book_();return {actor:actor,revision:PropertiesService.getScriptProperties().getProperty('REVISION'),data:publicData_(),admins:actor.role==='Admin'?records_(book,'Admins'):[],log:actor.role==='Admin'?records_(book,'Change_Log').slice(-100).reverse():[]};}
function validate_(data){
 if(!data||!Array.isArray(data.subjects)||!Array.isArray(data.combinations)||!Array.isArray(data.eligibility))throw Error('Invalid content.');
 const ids=data.subjects.map(s=>s.subject_id);if(new Set(ids).size!==ids.length)throw Error('Subject IDs must be unique.');
 data.subjects.forEach(s=>{if(!/^[a-z0-9_-]{1,50}$/.test(s.subject_id)||!s.subject_name||!Array.isArray(s.levels)||s.levels.some(l=>!['G1','G2','G3'].includes(l)))throw Error('Check subject ID, name and levels.');['suitable_for','skills'].forEach(k=>{if(!Array.isArray(s[k]))throw Error(k+' must be an array.');});});
 const comboIds=data.combinations.map(c=>c.combination_id);if(new Set(comboIds).size!==comboIds.length)throw Error('Combination IDs must be unique.');
 if(!['G1','G2','G3'].every(p=>data.combinations.some(c=>c.profile===p&&c.active)))throw Error('Keep at least one active combination for every profile.');
 data.combinations.forEach(c=>{if(!/^[a-z0-9_-]{1,50}$/.test(c.combination_id)||!['G1','G2','G3'].includes(c.profile)||!c.combination_name||!Array.isArray(c.groups))throw Error('Check combination ID, name, profile and groups.');if(new Set(c.groups.map(g=>g.id)).size!==c.groups.length)throw Error('Group IDs must be unique.');const refs=[...(c.compulsory||[]),...(c.optional||[]),...(c.closed_optional||[])];if(c.optional_groups!==undefined&&!Array.isArray(c.optional_groups))throw Error('Optional groups must be an array.');(c.optional_groups||[]).forEach(g=>{if(!g.id||!g.label||!Array.isArray(g.options)||!g.options.length||new Set(g.options).size!==g.options.length||g.min_select!==0||g.max_select!==1)throw Error('Optional groups need unique choices and allow zero or one selection.');refs.push(...g.options);});c.groups.forEach(g=>{if(!g.id||!g.label||!Array.isArray(g.options)||!g.options.length||new Set(g.options).size!==g.options.length)throw Error('Each selection group needs an ID, label and unique choices.');refs.push(...g.options);});if(refs.some(id=>!ids.includes(id)))throw Error('Combination contains an unknown subject.');if(c.active&&refs.some(id=>!data.subjects.find(s=>s.subject_id===id).active))throw Error('Remove archived subjects from active combinations first.');});
 data.eligibility.forEach(e=>{if(!ids.includes(e.subject_id)&&!comboIds.includes(e.subject_id))throw Error('Eligibility refers to an unknown subject or combination.');if(!['G1','G2','G3'].includes(e.subject_level))throw Error('Eligibility needs a valid subject level.');});
}
function saveContent(payload){const lock=LockService.getScriptLock();lock.waitLock(15000);try{const actor=staff_(),props=PropertiesService.getScriptProperties();if(String(payload.revision)!==props.getProperty('REVISION'))throw Error('Content changed since you opened it. Reload before saving.');if(!payload.request_id||typeof payload.request_id!=='string')throw Error('Missing request ID.');if(props.getProperty('LAST_REQUEST')===payload.request_id)throw Error('This save has already been applied. Reload to see the latest content.');if(JSON.stringify(payload.data).length>250000)throw Error('Content is too large.');validate_(payload.data);const book=book_(),before=publicData_();write_(book,'Subjects',payload.data.subjects);write_(book,'Subject_Combinations',payload.data.combinations);write_(book,'Combination_Subjects',flatten_(payload.data.combinations));write_(book,'Subject_Eligibility',payload.data.eligibility);const revision=String(Number(props.getProperty('REVISION'))+1);props.setProperties({REVISION:revision,LAST_REQUEST:payload.request_id});['subjects','combinations','eligibility'].forEach(k=>{if(JSON.stringify(before[k])!==JSON.stringify(payload.data[k]))book.getSheetByName('Change_Log').appendRow([new Date().toISOString(),actor.email,'update',k,'content',JSON.stringify(before[k]),JSON.stringify(payload.data[k])]);});return getAdminData();}finally{lock.releaseLock();}}
function saveAdmins(payload){const lock=LockService.getScriptLock();lock.waitLock(15000);try{const actor=staff_();if(actor.role!=='Admin')throw Error('Only Admins may manage access.');const props=PropertiesService.getScriptProperties();if(String(payload.revision)!==props.getProperty('REVISION'))throw Error('Reload before saving: content has changed.');const list=payload.admins;if(!Array.isArray(list)||list.length>100)throw Error('Invalid allowlist.');list.forEach(a=>{if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(a.email)||!['Admin','Editor'].includes(a.role))throw Error('Check staff email and role.');a.email=a.email.toLowerCase();});if(new Set(list.map(a=>a.email)).size!==list.length)throw Error('Duplicate email.');if(!list.some(a=>a.email===actor.email&&a.role==='Admin'&&a.active))throw Error('Keep your own Admin access active.');const book=book_(),before=records_(book,'Admins');write_(book,'Admins',list);props.setProperty('REVISION',String(Number(payload.revision)+1));book.getSheetByName('Change_Log').appendRow([new Date().toISOString(),actor.email,'update','admins','allowlist',JSON.stringify(before),JSON.stringify(list)]);return getAdminData();}finally{lock.releaseLock();}}
